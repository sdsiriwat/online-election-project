// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  VOTER
  ECT
}


model users {
  id          Int      @unique @id @default(autoincrement())
  nationalId  String   @unique
  firstname   String
  lastname    String
  password    String
  imageurl    String?
  address     String
  subdistrict String
  district    String
  province    String
  postalCode  String
  consituencynumber Int
  roleName    RoleName @default(VOTER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  consituency   consituency? @relation(fields: [consituencynumber], references: [id])
  vote        vote[]
  role        role[]
}

model role {
  id              Int      @id @default(autoincrement())
  usersId         Int
  roleName        RoleName
  discription     String

  user            users     @relation(fields: [usersId], references: [id])
}



model consituency {
  id            Int      @id @default(autoincrement())
  province      String              
  number        Int
  isclosed      Boolean  @default(true)

  user          users[]
  candidates    candidate[]

  @@unique([province, number])
}

model party {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  imageurl  String?
  policy    String?

  candidates candidate[]
}


model candidate {
  id                  Int      @id @default(autoincrement())
  candidateNumber     Int
  firstname           String
  lastname            String
  imageurl            String?
  consituencyId       Int
  partyId             Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  consituency         consituency @relation(fields: [consituencyId], references: [id])
  party               party       @relation(fields: [partyId], references: [id])
  vote                vote[]

  @@unique([consituencyId, candidateNumber])
}


model vote {
  id          Int      @id @default(autoincrement())
  usersId     Int
  candidateId Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        users     @relation(fields: [usersId], references: [id])
  candidate   candidate @relation(fields: [candidateId], references: [id])

  @@unique([usersId, candidateId])
}