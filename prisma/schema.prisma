generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ROLE_ADMIN
  ROLE_VOTER
  ROLE_ECT
}



model users {
  id                Int         @id @unique @default(autoincrement())
  nationalId        String      @unique
  firstname         String
  lastname          String
  password          String
  imageurl          String?
  address           String
  subdistrict       String
  district          String
  province          String
  consituencyID     Int
  updatedAt         DateTime    @updatedAt

  role              role[]
  consituency       consituency @relation(fields: [consituencyID], references: [id])
  vote              vote[]
}

model role {
  id          Int      @id @default(autoincrement())
  usersId     Int
  roleName    RoleName

  user        users    @relation(fields: [usersId], references: [id])
  @@unique([usersId, roleName])
}


model consituency {
  id                  Int     @id @default(autoincrement())
  province            String
  consituencynumber   Int
  subdistrict         String
  district            String
  zipcode             String
  isclosed            Boolean @default(true)

  candidates candidate[]
  user       users[]
  @@unique([province, consituencynumber])
}


model party {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  imageurl   String?
  policy     String?
  candidates candidate[]
}


model candidate {
  id                  Int         @id @default(autoincrement())
  candidateNumber     Int
  firstname           String
  lastname            String
  imageurl            String?
  consituencyId       Int
  consituencyProvince String
  partyId             Int
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  
  consituency     consituency @relation(fields: [consituencyId], references: [id])
  party           party       @relation(fields: [partyId], references: [id])
  vote            vote[]

  @@unique([candidateNumber,partyId, consituencyId, consituencyProvince])
}

model vote {
  id          Int       @id @default(autoincrement())
  usersId     Int
  candidateId Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  candidate   candidate @relation(fields: [candidateId], references: [id])
  user        users     @relation(fields: [usersId], references: [id])
  @@unique([usersId, candidateId])
}

